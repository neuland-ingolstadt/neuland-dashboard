# App
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=http://127.0.0.1:43127

# Authentik OIDC
AUTHENTIK_ISSUER=https://sso.example.com/application/o/neuland-dashboard/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Legacy aliases also supported: AUTHENTIK_ID / AUTHENTIK_SECRET

# Optional Authentik group name overrides (defaults shown)
# SPORTS_GROUP_NAME=next-dashboard-sports
# ANNOUNCEMENTS_GROUP_NAME=next-dashboard-announcements
# REPORTS_GROUP_NAME=next-dashboard-reports
# ADMIN_GROUP_NAME=next-dashboard-admin

# GraphQL API
GRAPHQL_URL=https://api.neuland.app/graphql
DEV_GRAPHQL_URL=https://api.dev.neuland.app/graphql

# S3 / object storage (announcement images)
S3_REGION=nbg1
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local mock auth (no Authentik required)
AUTH_MOCK=false
