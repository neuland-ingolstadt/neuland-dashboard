{
	"name": "neuland-dashboard",
	"private": true,
	"license": "AGPL-3.0-only",
	"packageManager": "bun@1.4.2",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 43127",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 43127",
		"start": "bun .output/server/index.mjs",
		"format": "biome check --write .",
		"lint": "biome check .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"docker:build": "docker build --build-arg BUN_VERSION=$(tr -d '[:space:]' < .bun-version) -t neuland-dashboard ."
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1179.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/ibm-plex-sans": "5.3.0",
		"@hookform/resolvers": "3.10.0",
		"@neuland-ingolstadt/backend-core-api": "1.2.4",
		"@radix-ui/react-checkbox": "1.4.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-select": "2.4.1",
		"@radix-ui/react-separator": "1.2.0",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-switch": "1.4.1",
		"@radix-ui/react-tabs": "1.2.1",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/react-table": "8.21.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.4.0",
		"lucide-react": "1.83.0",
		"nitro": "3.0.260610-beta",
		"openapi-fetch": "0.17.0",
		"openid-client": "6.9.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.92.0",
		"sharp": "0.35.5",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.1",
		"tailwindcss": "4.3.5",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@tanstack/router-cli": "^1.167.39",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.0",
		"vite": "^8.3.1"
	}
}
