{
	"name": "neuland-dashboard",
	"private": true,
	"license": "AGPL-3.0-only",
	"packageManager": "bun@1.4.2",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 43127",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 43127",
		"start": "bun .output/server/index.mjs",
		"format": "biome check --write .",
		"lint": "biome check .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"docker:build": "docker build --build-arg BUN_VERSION=$(tr -d '[:space:]' < .bun-version) -t neuland-dashboard ."
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1089.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@hookform/resolvers": "^3.10.0",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.21",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"graphql": "^17.0.0",
		"graphql-request": "^7.3.1",
		"lucide-react": "^1.48.0",
		"nitro": "3.0.260610-beta",
		"openid-client": "^6.8.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.66.0",
		"sharp": "^0.34.4",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@tanstack/router-cli": "^1.167.39",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.1"
	}
}
